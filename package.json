{
  "name": "@local/hindsight-graph",
  "version": "0.1.0",
  "type": "module",
  "description": "Explore the Hindsight coding-agent memory as a graph in the Web UI: memory units and their semantic, temporal and entity links, plus an entity co-mention view.",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "license": "MIT",
  "author": "Leonard-Data",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Leonard-Data/hindsight-graph.git"
  },
  "bugs": {
    "url": "https://github.com/Leonard-Data/hindsight-graph/issues"
  },
  "homepage": "https://github.com/Leonard-Data/hindsight-graph#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "hindsight",
    "memory",
    "graph",
    "plugin",
    "web-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.mjs",
    "build": "npm pack --dry-run",
    "check:version": "node .github/scripts/check-version.mjs",
    "check:files": "node .github/scripts/check-files.mjs"
  }
}
